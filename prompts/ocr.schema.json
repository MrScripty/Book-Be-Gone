{
  "type": "object",
  "properties": {
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "page_number": {
            "pattern": "^[A-Za-z0-9]+$",
            "maxLength": 200,
            "description": "Only the visible printed number label, e.g. 390 or xiv; null when absent or unreadable. Never a title, filename, or JSON punctuation.",
            "type": [
              "string",
              "null"
            ]
          },
          "chapter_seen": {
            "description": "Visible chapter title or unambiguous running chapter header, not the book title or a subsection. Null if not established on this page; the app inherits the previous chapter.",
            "type": [
              "string",
              "null"
            ]
          },
          "markdown": {
            "type": "string"
          },
          "figures": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^figure-[1-9][0-9]*$"
                },
                "bbox": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "description": {
                  "type": "string"
                },
                "format": {
                  "type": "string",
                  "enum": [
                    "mermaid",
                    "text"
                  ]
                },
                "representation": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "bbox",
                "description",
                "format",
                "representation"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "page_number",
          "chapter_seen",
          "markdown",
          "figures"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "pages"
  ],
  "additionalProperties": false
}
